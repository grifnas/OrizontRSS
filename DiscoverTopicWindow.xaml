<Window x:Class="CititorRSS.Jaws.DiscoverTopicWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Caută feeduri după subiect" Width="820" Height="560" MinWidth="660" MinHeight="460" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Caută feeduri RSS după subiect" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Caută în catalog publicații și rubrici concrete, de exemplu tehnologie, economie, cultură sau actualitate. Verifică rezultatul înainte de adăugare." Style="{StaticResource DialogIntroTextStyle}" /><Label Content="Subiect sau cuvinte-cheie" Target="{Binding ElementName=Keywords}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="Keywords" KeyDown="Keywords_KeyDown" AutomationProperties.Name="Cuvinte-cheie pentru feeduri" AutomationProperties.HelpText="Scrie un subiect și apasă Enter sau butonul Caută feeduri." /><Button Grid.Column="1" Content="Caută feeduri" Click="Search_Click" /></Grid><TextBlock x:Name="StatusText" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" /></StackPanel>
    <GroupBox Grid.Row="1" Header="Rezultate" Margin="4,12,4,4"><ListBox x:Name="Results" SelectionChanged="Results_SelectionChanged" AutomationProperties.Name="Feeduri concrete găsite, listă" AutomationProperties.HelpText="Folosește săgețile Sus și Jos. Verifică feedul selectat înainte de adăugare."><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Status}" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding Url}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox>
    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}"><Button Content="Verifică feedul selectat" Click="Verify_Click" /><Button x:Name="AddButton" Content="Adaugă feed verificat" IsEnabled="False" Click="Add_Click" /><Button Content="Închide" IsCancel="True" /></StackPanel>
  </Grid>
</Window>
