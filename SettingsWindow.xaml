<Window x:Class="CititorRSS.Jaws.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Setări Orizont RSS" Icon="Assets/OrizontRSS.ico" Width="680" Height="660" MinWidth="580" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock x:Name="SettingsTitle" Text="Setări Orizont RSS" Style="{StaticResource SectionTitleTextStyle}" />
      <TextBlock x:Name="SettingsIntro" Text="Modificările sunt păstrate numai după alegerea butonului Salvează." Style="{StaticResource DialogIntroTextStyle}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,8,0">
        <GroupBox x:Name="LanguageGroup" Header="General"><StackPanel Margin="12"><Label Content="Limba interfeței" Target="{Binding ElementName=UiLanguage}" /><ComboBox x:Name="UiLanguage" AutomationProperties.Name="Limba interfeței" /><TextBlock Text="Limba aleasă se aplică după repornirea aplicației." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" /></StackPanel></GroupBox>
        <GroupBox x:Name="StorageGroup" Header="Date și stocare" Margin="4,14,4,4"><StackPanel Margin="12"><CheckBox x:Name="AutoCleanup" Content="Șterge automat articolele obișnuite expirate" AutomationProperties.Name="Șterge automat articolele obișnuite expirate" /><Label Content="Păstrează articolele obișnuite timp de" Target="{Binding ElementName=RetentionDays}" /><ComboBox x:Name="RetentionDays" AutomationProperties.Name="Perioada de păstrare a articolelor obișnuite"><ComboBoxItem Content="1 zi" Tag="1" /><ComboBoxItem Content="3 zile" Tag="3" /><ComboBoxItem Content="7 zile" Tag="7" /><ComboBoxItem Content="14 zile" Tag="14" /><ComboBoxItem Content="30 zile" Tag="30" /><ComboBoxItem Content="60 zile" Tag="60" /><ComboBoxItem Content="90 zile" Tag="90" /><ComboBoxItem Content="180 zile" Tag="180" /><ComboBoxItem Content="365 zile" Tag="365" /></ComboBox><TextBlock Text="Favoritele și articolele De citit mai târziu sunt protejate și nu sunt șterse automat." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" /></StackPanel></GroupBox>
        <GroupBox x:Name="UpdateGroup" Header="Actualizare și afișare" Margin="4,14,4,4"><StackPanel Margin="12"><CheckBox x:Name="UpdateAtStartup" Content="Actualizează feedurile la pornire" AutomationProperties.Name="Actualizează feedurile la pornire" /><CheckBox x:Name="SoundAlerts" Content="Activează alertele sonore" AutomationProperties.Name="Activează alertele sonore" AutomationProperties.HelpText="Controlează toate alertele sonore ale actualizării feedurilor." /><CheckBox x:Name="SoundAlertOnSuccess" Content="Alertă la finalizarea reușită" AutomationProperties.Name="Alertă la finalizarea reușită" /><CheckBox x:Name="SoundAlertOnNewArticles" Content="Alertă când există articole noi" AutomationProperties.Name="Alertă când există articole noi" /><CheckBox x:Name="SoundAlertOnErrors" Content="Alertă la erori de feed" AutomationProperties.Name="Alertă la erori de feed" /><WrapPanel Margin="0,4,0,4"><Button x:Name="TestSoundButton" Content="Testează sunetul" Click="TestSound_Click" /></WrapPanel><TextBlock x:Name="SoundAlertStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" /><CheckBox x:Name="HideRepeatedArticles" Content="Ascunde articolele repetate în vederile globale" AutomationProperties.Name="Ascunde articolele repetate în vederile globale" AutomationProperties.HelpText="Nu șterge articolele din feeduri. Afișează o singură copie când sunt combinate mai multe surse." /><Label Content="Afișează articolele noi în Citește acum pentru" Target="{Binding ElementName=ReadNowFavoriteDays}" /><ComboBox x:Name="ReadNowFavoriteDays" AutomationProperties.Name="Perioada articolelor noi în Citește acum"><ComboBoxItem Content="1 zi" Tag="1" /><ComboBoxItem Content="3 zile" Tag="3" /><ComboBoxItem Content="7 zile" Tag="7" /><ComboBoxItem Content="14 zile" Tag="14" /><ComboBoxItem Content="30 zile" Tag="30" /><ComboBoxItem Content="60 zile" Tag="60" /><ComboBoxItem Content="90 zile" Tag="90" /></ComboBox><TextBlock Text="Favoritele și articolele De citit mai târziu rămân în Citește acum indiferent de vechime, până când le elimini manual." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" /></StackPanel></GroupBox>
        <GroupBox x:Name="SpeechSettingsGroup" Header="Citire vocală" Margin="4,14,4,4">
          <StackPanel Margin="12">
            <TextBlock Text="Vocea pornește numai la comanda ta și nu înlocuiește cititorul de ecran pentru citirea interfeței." Style="{StaticResource SecondaryTextStyle}" Margin="4,0,4,8" />
            <Label x:Name="SpeechEngineLabel" Content="Motor vocal" Target="{Binding ElementName=SpeechEngine}" />
            <ComboBox x:Name="SpeechEngine" AutomationProperties.Name="Motor vocal" SelectionChanged="SpeechEngine_SelectionChanged">
              <ComboBoxItem x:Name="Sapi5EngineItem" Content="SAPI5, vocile instalate în Windows" Tag="Sapi5" />
              <ComboBoxItem x:Name="EspeakEngineItem" Content="eSpeak NG, inclus în Orizont RSS" Tag="EspeakNg" />
              <ComboBoxItem x:Name="GeminiEngineItem" Content="Gemini TTS, voci online" Tag="GeminiTts" />
            </ComboBox>
            <Label x:Name="SpeechVoiceLabel" Content="Voce" Target="{Binding ElementName=SpeechVoice}" />
            <ComboBox x:Name="SpeechVoice" AutomationProperties.Name="Vocea motorului vocal" />
            <Label Content="Viteză, de la minus 10 la 10" Target="{Binding ElementName=SpeechRate}" />
            <ComboBox x:Name="SpeechRate" AutomationProperties.Name="Viteza vocii" />
            <StackPanel x:Name="EspeakPitchPanel">
              <Label x:Name="EspeakPitchLabel" Content="Înălțimea vocii eSpeak, de la 0 la 100" Target="{Binding ElementName=EspeakPitch}" />
              <ComboBox x:Name="EspeakPitch" AutomationProperties.Name="Înălțimea vocii eSpeak" />
            </StackPanel>
            <TextBlock x:Name="GeminiSpeechNotice" Text="Gemini TTS este online. Textul citit este trimis la Google și poate consuma cota sau creditele API." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,2" Visibility="Collapsed" />
            <Label Content="Volum" Target="{Binding ElementName=SpeechVolume}" />
            <ComboBox x:Name="SpeechVolume" AutomationProperties.Name="Volumul vocii"><ComboBoxItem Content="25 la sută" Tag="25" /><ComboBoxItem Content="50 la sută" Tag="50" /><ComboBoxItem Content="75 la sută" Tag="75" /><ComboBoxItem Content="100 la sută" Tag="100" /></ComboBox>
            <CheckBox x:Name="StopSpeechWhenLeavingArticle" Content="Oprește vocea când ies din conținutul articolului cu Escape" AutomationProperties.Name="Oprește vocea când ies din conținutul articolului" />
            <WrapPanel Margin="0,6,0,0"><Button x:Name="TestSpeechButton" Content="Testează vocea" Click="TestSpeech_Click" /><Button Content="Oprește testul" Click="StopSpeechTest_Click" /></WrapPanel>
            <TextBlock x:Name="SpeechStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </GroupBox>
        <GroupBox x:Name="AiSettingsGroup" Header="Inteligență artificială" Margin="4,14,4,4"><StackPanel Margin="12"><TextBlock Text="Gemini" FontWeight="SemiBold" Margin="4,2,4,6" /><CheckBox x:Name="GeminiEnabled" Content="Activează Gemini" AutomationProperties.Name="Activează Gemini" /><Label Content="Cheie API Gemini" Target="{Binding ElementName=GeminiKey}" /><PasswordBox x:Name="GeminiKey" AutomationProperties.Name="Cheie API Gemini" /><WrapPanel Margin="0,6,0,0"><Button x:Name="TestGeminiButton" Content="Testează conexiunea Gemini" Click="TestGemini_Click" /><Button Content="Obține cheie API Gemini" Click="GeminiKey_Click" /></WrapPanel><TextBlock x:Name="GeminiStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="Testul verifică modelele disponibile și nu trimite niciun articol." Style="{StaticResource SecondaryTextStyle}" Margin="4,2,4,8" /><Separator Margin="4,8" /><TextBlock x:Name="DeepLTitle" Text="DeepL" FontWeight="SemiBold" Margin="4,2,4,6" /><CheckBox x:Name="DeepLEnabled" Content="Activează traducerea cu DeepL" AutomationProperties.Name="Activează traducerea cu DeepL" /><Label Content="Cheie API DeepL" Target="{Binding ElementName=DeepLKey}" /><PasswordBox x:Name="DeepLKey" AutomationProperties.Name="Cheie API DeepL" /><WrapPanel Margin="0,6,0,0"><Button x:Name="TestDeepLButton" Content="Testează conexiunea DeepL" Click="TestDeepL_Click" /><Button Content="Obține cheie API DeepL" Click="DeepLKey_Click" /></WrapPanel><TextBlock x:Name="DeepLStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="DeepLNotice" Text="DeepL este un serviciu online. Articolul este trimis la DeepL și consumă limita contului API." Style="{StaticResource SecondaryTextStyle}" Margin="4,2,4,8" /><TextBlock x:Name="DeepLInstructions" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="4,0,4,8" AutomationProperties.Name="DeepL setup instructions" /><Separator Margin="4,8" /><Label Content="Instrucțiuni permanente pentru agent" Target="{Binding ElementName=AiInstructions}" /><TextBox x:Name="AiInstructions" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Instrucțiuni permanente pentru agentul AI" /><TextBlock Text="Instrucțiunile se aplică rezumării, traducerii și conversațiilor viitoare despre articole." Style="{StaticResource SecondaryTextStyle}" Margin="4,6,4,0" /></StackPanel></GroupBox>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}"><Button x:Name="CleanupButton" Content="Curăță acum articolele expirate" Click="CleanupNow_Click" /><Button Content="Anulează" IsCancel="True" /><Button Content="Salvează" IsDefault="True" Click="Save_Click" /></StackPanel>
  </Grid>
</Window>
