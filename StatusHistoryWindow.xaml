<Window x:Class="CititorRSS.Jaws.StatusHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orizont RSS" Icon="Assets/OrizontRSS.ico" Width="860" Height="560"
        MinWidth="560" MinHeight="380" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Istoric stare și erori" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Mesajele sunt păstrate numai pentru sesiunea curentă și pot fi copiate sau salvate pentru diagnostic." Style="{StaticResource DialogIntroTextStyle}" /></StackPanel>
    <TextBox Grid.Row="1" x:Name="HistoryText" Style="{StaticResource ReadOnlyDocumentStyle}" AutomationProperties.Name="Istoric stare și erori, text numai citire" AutomationProperties.HelpText="Folosește săgețile pentru citire. Ctrl+C copiază textul selectat. Escape închide fereastra." />
    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}">
      <Button Content="Copiază tot" Click="Copy_Click" />
      <Button Content="Salvează diagnosticul" Click="Save_Click" />
      <Button Content="Golește istoricul" Click="Clear_Click" />
      <Button Content="Închide" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
