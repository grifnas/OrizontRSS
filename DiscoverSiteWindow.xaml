<Window x:Class="CititorRSS.Jaws.DiscoverSiteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Găsește feeduri pe un site" Width="820" Height="560" MinWidth="660" MinHeight="460" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Găsește feeduri RSS pe un site" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Introdu pagina principală a unei publicații. Orizont caută feedurile declarate și adresele RSS uzuale; fiecare rezultat trebuie verificat înainte de adăugare." Style="{StaticResource DialogIntroTextStyle}" /><Label Content="Adresa site-ului" Target="{Binding ElementName=SiteAddress}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SiteAddress" KeyDown="SiteAddress_KeyDown" AutomationProperties.Name="Adresa site-ului" AutomationProperties.HelpText="Introdu o adresă web și apasă Enter sau butonul Găsește feeduri." /><Button Grid.Column="1" Content="Găsește feeduri" Click="Discover_Click" /></Grid><TextBlock x:Name="StatusText" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" /></StackPanel>
    <GroupBox Grid.Row="1" Header="Rezultate" Margin="4,12,4,4"><ListBox x:Name="FoundFeeds" SelectionChanged="FoundFeeds_SelectionChanged" AutomationProperties.Name="Feeduri găsite, listă" AutomationProperties.HelpText="Folosește săgețile Sus și Jos. Verifică feedul selectat înainte de adăugare."><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Status}" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding Url}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox>
    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}"><Button Content="Verifică feedul selectat" Click="Verify_Click" /><Button x:Name="AddButton" Content="Adaugă feed verificat" IsEnabled="False" Click="Add_Click" /><Button Content="Închide" IsCancel="True" /></StackPanel>
  </Grid>
</Window>
