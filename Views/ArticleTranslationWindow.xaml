<Window x:Class="CititorRSS.Jaws.ArticleTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traducere Google Translate" Width="850" Height="650"
        MinWidth="520" MinHeight="360" WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Traducerea articolului" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
    <TextBox x:Name="TranslatedText" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True"
             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             FontSize="18" AutomationProperties.Name="Text tradus cu Google Translate"
             AutomationProperties.HelpText="Folosește săgețile pentru a citi traducerea. Escape închide fereastra și revine la articol." />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="EmailButton" Content="Distribuie prin e-mail" Click="ShareByEmail_Click" MinWidth="170" Margin="0,0,8,0" />
      <Button x:Name="WhatsAppButton" Content="Distribuie prin WhatsApp" Click="ShareByWhatsApp_Click" MinWidth="190" Margin="0,0,8,0" />
      <Button x:Name="CloseButton" Content="Închide" IsCancel="True" MinWidth="110" />
    </StackPanel>
  </Grid>
</Window>
