<Window x:Class="CititorRSS.Jaws.HelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ajutor Orizont RSS" Icon="/Assets/OrizontRSS.ico" Width="820" Height="620" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Ajutor Orizont RSS" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Caută după tastă, comandă sau categorie. Tab trece la rezultate; săgețile parcurg lista. Ctrl+F revine la căutare. Escape închide ghidul. Comenzile se folosesc în zona indicată." Style="{StaticResource DialogIntroTextStyle}" />
      <Label Content="Caută scurtături" Target="{Binding ElementName=ShortcutSearchBox}" />
      <TextBox x:Name="ShortcutSearchBox" AutomationProperties.Name="Caută scurtături" TextChanged="Search_TextChanged" Margin="0,0,0,8" />
    </StackPanel>
    <Grid Grid.Row="1">
    <ListBox x:Name="ShortcutList" AutomationProperties.Name="Scurtături de tastatură Orizont RSS">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" /></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Category}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,2" /><TextBlock Text="{Binding Shortcut}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyResults" Text="Nu s-au găsit scurtături. Modifică termenii căutării." Visibility="Collapsed" IsHitTestVisible="False" TextWrapping="Wrap" Margin="12" Style="{StaticResource SecondaryTextStyle}" />
    </Grid>
    <StackPanel Grid.Row="2">
      <TextBlock x:Name="ResultStatus" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Margin="0,8,0,0" />
      <StackPanel Style="{StaticResource DialogButtonBarStyle}"><Button Content="Deschide ghidul complet HTML" Click="OpenGuide_Click" AutomationProperties.Name="Deschide ghidul complet al utilizatorului în browser" /><Button Content="Închide" IsCancel="True" /></StackPanel>
    </StackPanel>
  </Grid>
</Window>
