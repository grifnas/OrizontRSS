<Window x:Class="CititorRSS.Jaws.YouTubeSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caută pe YouTube" Width="820" Height="600" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
  <DockPanel>
    <StatusBar x:Name="WindowStatusBar" DockPanel.Dock="Bottom" Margin="0,8,0,0" Focusable="False" IsTabStop="False" AutomationProperties.LiveSetting="Polite">
      <StatusBarItem Focusable="False" IsTabStop="False"><TextBlock x:Name="WindowStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StatusBarItem>
    </StatusBar>
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="Caută pe YouTube" Style="{StaticResource SectionTitleTextStyle}" />
        <TextBlock Text="Căutarea trimite termenul direct către YouTube, fără cheie API." Style="{StaticResource DialogIntroTextStyle}" />

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <Label Content="Cuvinte-cheie" Target="{Binding ElementName=Keywords}" />
            <TextBox x:Name="Keywords" KeyDown="Keywords_KeyDown" AutomationProperties.Name="Cuvinte-cheie pentru căutarea pe YouTube" AutomationProperties.HelpText="Tastați un termen și apăsați Enter sau Caută." />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <Label Content="Tip căutare" Target="{Binding ElementName=SearchType}" />
            <ComboBox x:Name="SearchType" SelectionChanged="SearchType_SelectionChanged" KeyDown="SearchType_KeyDown" AutomationProperties.Name="Tip căutare" />
          </StackPanel>

          <Button x:Name="SearchButton" Grid.Column="2" Content="Caută" Click="Search_Click" VerticalAlignment="Bottom" Padding="16,4" />
        </Grid>

        <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatusTextStyle}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <GroupBox Grid.Row="1" Header="Rezultate" Margin="0,10,0,4">
        <ListBox x:Name="Results" SelectionChanged="Results_SelectionChanged" KeyDown="Results_KeyDown" MouseDoubleClick="Results_MouseDoubleClick" AutomationProperties.Name="Rezultate YouTube, listă" AutomationProperties.HelpText="Folosește săgețile Sus și Jos. Pentru canale și playlisturi apasă Enter pentru adăugare; pentru videoclipuri apasă Enter pentru deschidere în browser.">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2,0,2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Status}" Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Url}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </GroupBox>

      <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}">
        <Button x:Name="VerifyFeedButton" Content="Verifică feedul selectat" Click="VerifyFeed_Click" IsEnabled="False" Visibility="Collapsed" />
        <Button x:Name="OpenResultPageButton" Content="Deschide în browser" Click="OpenResultPage_Click" IsEnabled="False" Visibility="Collapsed" />
        <Button x:Name="AddFeedButton" Content="Adaugă feed verificat" Click="AddFeed_Click" IsEnabled="False" />
        <Button x:Name="OpenVideoButton" Content="Deschide în browser" Click="OpenVideo_Click" IsEnabled="False" Visibility="Collapsed" />
        <Button x:Name="LoadMoreButton" Content="Mai multe rezultate" Click="LoadMore_Click" IsEnabled="False" Visibility="Collapsed"
                AutomationProperties.HelpText="Încarcă următoarea pagină de rezultate YouTube și o adaugă la lista de mai sus." />
        <Button x:Name="SubscribeChannelButton" Content="Abonează-te la canal" Click="SubscribeChannel_Click" IsEnabled="False" Visibility="Collapsed" AutomationProperties.HelpText="Caută fluxul RSS al canalului asociat videoclipului și îl adaugă în abonamente." />
        <Button x:Name="ImportTranscriptButton" Content="Transcript YouTube" Click="ImportTranscript_Click" IsEnabled="False" Visibility="Collapsed"
                AutomationProperties.HelpText="Deschide fereastra de import transcript pentru videoclipul selectat." />
        <Button Content="Închide" IsCancel="True" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
