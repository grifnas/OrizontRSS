<Window x:Class="CititorRSS.Jaws.ArticleRulesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Reguli automate" Width="740" Height="570" MinWidth="550" MinHeight="400" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="20">
  <TextBlock DockPanel.Dock="Top" Text="Regulile adaugă etichete și marcajul Mai târziu numai articolelor noi. Testarea nu modifică articolele." TextWrapping="Wrap" Margin="0,0,0,12"/>
  <StackPanel DockPanel.Dock="Bottom">
   <WrapPanel>
    <Button Content="Adaugă" Click="Add_Click"/><Button Content="Editează" Click="Edit_Click"/>
    <Button Content="Șterge" Click="Delete_Click"/><Button Content="Activează sau dezactivează" Click="Toggle_Click"/>
    <Button Content="Testează regula selectată" Click="Test_Click"/><Button Content="Previzualizează regulile active" Click="Preview_Click"/>
   </WrapPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Închide" IsCancel="True"/>
   </StackPanel>
  </StackPanel>
  <Grid>
   <ListBox x:Name="RuleList" AutomationProperties.Name="Reguli automate" DisplayMemberPath="Display">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
     </Style>
    </ListBox.ItemContainerStyle>
   </ListBox>
   <TextBlock x:Name="EmptyMessage" Text="Nu există reguli automate." Margin="8" IsHitTestVisible="False" VerticalAlignment="Top"/>
  </Grid>
 </DockPanel>
</Window>
