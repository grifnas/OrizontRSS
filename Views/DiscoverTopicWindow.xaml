<Window x:Class="CititorRSS.Jaws.DiscoverTopicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caută feeduri după subiect" Width="840" Height="580" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Caută feeduri RSS după subiect" Style="{StaticResource SectionTitleTextStyle}" />
      <TextBlock Text="Alege o categorie din catalogul verificat sau caută după cuvinte-cheie. Opțional, poți extinde căutarea pe internet." Style="{StaticResource DialogIntroTextStyle}" />

      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,6,0">
          <Label Content="Categorie" Target="{Binding ElementName=CategoryFilter}" />
          <ComboBox x:Name="CategoryFilter" SelectionChanged="CategoryFilter_SelectionChanged" AutomationProperties.Name="Filtru categorie catalog" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="6,0,6,0">
          <Label Content="Cuvinte-cheie" Target="{Binding ElementName=Keywords}" />
          <TextBox x:Name="Keywords" KeyDown="Keywords_KeyDown" AutomationProperties.Name="Cuvinte-cheie pentru feeduri" AutomationProperties.HelpText="Tastați un subiect și apasă Enter sau Caută." />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
          <Button Content="Caută în catalog" Click="SearchCatalog_Click" Margin="0,0,6,0" />
          <Button x:Name="LiveSearchButton" Content="Caută pe internet" Click="LiveSearch_Click" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatusTextStyle}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <GroupBox Grid.Row="1" Header="Rezultate" Margin="0,12,0,4">
      <ListBox x:Name="Results" SelectionChanged="Results_SelectionChanged" AutomationProperties.Name="Feeduri găsite, listă" AutomationProperties.HelpText="Folosește săgețile Sus și Jos. Verifică feedul selectat înainte de adăugare.">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2,0,2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Status}" Margin="0,3,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Url}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </GroupBox>

    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}">
      <Button Content="Verifică feedul selectat" Click="Verify_Click" />
      <Button x:Name="AddButton" Content="Adaugă feed verificat" IsEnabled="False" Click="Add_Click" />
      <Button Content="Închide" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
