<Window x:Class="CititorRSS.Jaws.PodcastRateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viteza de redare" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <StatusBar x:Name="WindowStatusBar" DockPanel.Dock="Bottom" Margin="0,8,0,0" Focusable="False" IsTabStop="False" AutomationProperties.LiveSetting="Polite"><StatusBarItem Focusable="False" IsTabStop="False"><TextBlock x:Name="WindowStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StatusBarItem></StatusBar>
    <StackPanel Margin="24">
      <Label x:Name="RateLabel" Content="Valoare" Target="{Binding ElementName=RateBox}" />
      <ComboBox x:Name="RateBox" AutomationProperties.Name="Valoare" />
      <StackPanel Style="{StaticResource DialogButtonBarStyle}"><Button x:Name="CancelButton" Content="Anulează" IsCancel="True" /><Button x:Name="ApplyButton" Content="Aplică" IsDefault="True" Click="Apply_Click" /></StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
