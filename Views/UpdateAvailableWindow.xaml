<Window x:Class="CititorRSS.Jaws.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizare disponibilă — Orizont RSS" Icon="/Assets/OrizontRSS.ico"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Announcement -->
        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Status versiune nouă" />

        <TextBlock Grid.Row="1"
                   Text="Noutăți în această versiune:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <!-- Release Notes Text -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,12">
            <TextBox x:Name="ReleaseNotesTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Padding="8"
                     AutomationProperties.Name="Notele versiunii noi" />
        </Border>

        <!-- Download Progress Bar -->
        <ProgressBar x:Name="DownloadProgressBar"
                     Grid.Row="3"
                     Height="20"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Visibility="Collapsed"
                     Margin="0,0,0,8"
                     AutomationProperties.Name="Progres descărcare actualizare" />

        <!-- Status Message -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="4"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   AutomationProperties.LiveSetting="Polite" />

        <!-- Buttons Panel -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="InstallButton"
                    Content="Descărcă și instalează"
                    IsDefault="True"
                    MinWidth="150"
                    Height="32"
                    Padding="12,0,12,0"
                    Margin="0,0,8,0"
                    Click="Install_Click"
                    AutomationProperties.Name="Descărcă și instalează actualizarea" />

            <Button x:Name="GitHubButton"
                    Content="Deschide pe GitHub"
                    MinWidth="140"
                    Height="32"
                    Padding="12,0,12,0"
                    Margin="0,0,8,0"
                    Click="GitHub_Click"
                    AutomationProperties.Name="Deschide pagina versiunii pe GitHub" />

            <Button x:Name="CloseButton"
                    Content="Ignoră"
                    IsCancel="True"
                    MinWidth="90"
                    Height="32"
                    Padding="12,0,12,0"
                    Click="Close_Click"
                    AutomationProperties.Name="Ignoră actualizarea" />
        </StackPanel>
    </Grid>
</Window>
