<Window x:Class="CititorRSS.Jaws.YouTubeChannelVideosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Videoclipurile canalului" Width="760" Height="580" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
  <DockPanel>
    <StatusBar x:Name="WindowStatusBar" DockPanel.Dock="Bottom" Margin="0,8,0,0"
               Focusable="False" IsTabStop="False"
               AutomationProperties.LiveSetting="Polite">
      <StatusBarItem Focusable="False" IsTabStop="False">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
      </StatusBarItem>
    </StatusBar>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
      <Button x:Name="OpenButton" Content="Deschide în Orizont" Click="Open_Click" IsEnabled="False" Margin="0,0,8,0" />
      <Button x:Name="LoadMoreButton" Content="Mai multe rezultate" Click="LoadMore_Click" IsEnabled="False" Margin="0,0,8,0" />
      <Button Content="Închide" IsCancel="True" />
    </StackPanel>
    <ListBox x:Name="Videos" DisplayMemberPath="DisplayName" Margin="8"
             MouseDoubleClick="Videos_MouseDoubleClick" KeyDown="Videos_KeyDown"
             SelectionChanged="Videos_SelectionChanged"
             AutomationProperties.Name="Videoclipurile canalului, listă" />
  </DockPanel>
</Window>
