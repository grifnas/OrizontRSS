<Window x:Class="CititorRSS.Jaws.AiQuestionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Întreabă furnizorul AI despre articol" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24"><TextBlock x:Name="QuestionTitle" Text="Întrebarea ta despre articol" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Name="QuestionIntro" Text="Furnizorul AI primește conținutul complet disponibil în panoul de lectură și răspunde în contextul articolului." Style="{StaticResource DialogIntroTextStyle}" /><Label x:Name="QuestionLabel" Content="Scrie întrebarea" Target="{Binding ElementName=Question}" /><TextBox x:Name="Question" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Întrebarea pentru furnizorul AI" AutomationProperties.HelpText="Scrie întrebarea despre articol, apoi alege Trimite." /><StackPanel Style="{StaticResource DialogButtonBarStyle}"><Button x:Name="CancelButton" Content="Anulează" IsCancel="True" /><Button x:Name="SendButton" Content="Trimite" IsDefault="True" Click="Send_Click" /></StackPanel></StackPanel>
</Window>
