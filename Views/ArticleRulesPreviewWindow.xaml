<Window x:Class="CititorRSS.Jaws.ArticleRulesPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Previzualizare reguli" Width="780" Height="580" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <StatusBar x:Name="WindowStatusBar" DockPanel.Dock="Bottom" Margin="0,8,0,0" Focusable="False" IsTabStop="False" AutomationProperties.LiveSetting="Polite"><StatusBarItem Focusable="False" IsTabStop="False"><TextBlock x:Name="WindowStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StatusBarItem></StatusBar>
 <DockPanel Margin="20">
  <TextBlock DockPanel.Dock="Top" x:Name="Summary" TextWrapping="Wrap"/>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="ApplyButton" Content="Salvează regulile și aplică rezultatele" Click="Apply_Click"/>
   <Button Content="Închide" IsCancel="True"/>
  </StackPanel>
  <ListBox x:Name="Results" AutomationProperties.Name="Articole găsite după reguli" SelectionMode="Single"
           PreviewKeyDown="Results_KeyDown" MouseDoubleClick="Results_MouseDoubleClick" ContextMenuOpening="Results_ContextMenuOpening">
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
     <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <StackPanel Margin="4"><TextBlock Text="{Binding Display}" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/></StackPanel>
   </DataTemplate></ListBox.ItemTemplate>
   <ListBox.ContextMenu><ContextMenu AutomationProperties.Name="Acțiuni articol">
    <MenuItem Header="Deschide și citește" Click="OpenArticle_Click"/>
   </ContextMenu></ListBox.ContextMenu>
  </ListBox>
 </DockPanel>
  </DockPanel>
</Window>
