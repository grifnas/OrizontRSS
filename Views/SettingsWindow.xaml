<Window x:Class="CititorRSS.Jaws.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Setări Orizont RSS" Icon="/Assets/OrizontRSS.ico" Width="780" Height="680" MinWidth="680" MinHeight="540" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="SettingsTitle" Text="Setări Orizont RSS" Style="{StaticResource SectionTitleTextStyle}" />
      <Button x:Name="ShortcutSettingsButton" Content="Configurare scurtături" Click="ShortcutSettings_Click" HorizontalAlignment="Left" />
      <TextBlock x:Name="SettingsIntro" Text="Modificările sunt păstrate numai după alegerea butonului Salvează." Style="{StaticResource DialogIntroTextStyle}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,4,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Category List Navigation on the left -->
      <DockPanel Grid.Column="0" Margin="0,0,16,0">
        <Label x:Name="CategoriesLabel" DockPanel.Dock="Top" Content="Categorii" Target="{Binding ElementName=CategoryList}" Margin="0,0,0,4" />
        <ListBox x:Name="CategoryList"
                 AutomationProperties.Name="Categorii setări"
                 SelectionChanged="CategoryList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBoxItem x:Name="CategoryGeneralItem" Content="General" Tag="General" />
          <ListBoxItem x:Name="CategoryFeedsItem" Content="Feeduri și actualizare" Tag="Feeds" />
          <ListBoxItem x:Name="CategoryReaderItem" Content="Cititor Orizont" Tag="Reader" />
          <ListBoxItem x:Name="CategoryStorageItem" Content="Date și stocare" Tag="Storage" />
          <ListBoxItem x:Name="CategoryNewsBlurItem" Content="Sincronizare NewsBlur" Tag="NewsBlur" />
          <ListBoxItem x:Name="CategoryVoiceItem" Content="Citire vocală" Tag="Voice" />
          <ListBoxItem x:Name="CategoryAiItem" Content="Inteligență artificială și traducere" Tag="Ai" />
        </ListBox>
      </DockPanel>

      <!-- Category Content on the right -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="4,0,8,0">
          <!-- 1. General -->
          <StackPanel x:Name="GeneralCategoryPanel" Visibility="Visible">
            <GroupBox x:Name="AppearanceGroup" Header="Aspect și contrast">
              <StackPanel Margin="12">
                <Label x:Name="ColorSchemeLabel" Content="Temă de culori" Target="{Binding ElementName=ColorScheme}" />
                <ComboBox x:Name="ColorScheme" AutomationProperties.Name="Temă de culori">
                  <ComboBoxItem Content="Windows automat" Tag="Windows" />
                  <ComboBoxItem Content="Negru pe alb" Tag="BlackOnWhite" />
                  <ComboBoxItem Content="Alb pe negru" Tag="WhiteOnBlack" />
                  <ComboBoxItem Content="Negru pe galben" Tag="BlackOnYellow" />
                  <ComboBoxItem Content="Galben pe albastru închis" Tag="YellowOnNavy" />
                </ComboBox>
                <TextBlock x:Name="ColorSchemeNotice" Text="Windows automat respectă tema Contrast aleasă în Windows. Celelalte variante sunt optimizate pentru contrast ridicat și se aplică după salvare." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
            <GroupBox x:Name="LanguageGroup" Header="Limbă" Margin="0,14,0,0">
              <StackPanel Margin="12">
                <Label x:Name="LanguageLabel" Content="Limba interfeței" Target="{Binding ElementName=UiLanguage}" />
                <ComboBox x:Name="UiLanguage" AutomationProperties.Name="Limba interfeței" />
                <TextBlock x:Name="LanguageNotice" Text="Limba aleasă se aplică după repornirea aplicației." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" />
              </StackPanel>
            </GroupBox>
            <GroupBox x:Name="GeneralAppGroup" Header="Aplicație" Margin="0,14,0,0">
              <StackPanel Margin="12">
                <CheckBox x:Name="CheckAppUpdatesAtStartup" Content="Verifică actualizările aplicației la pornire" AutomationProperties.Name="Verifică actualizările aplicației la pornire" />
              </StackPanel>
            </GroupBox>
            <GroupBox x:Name="ArticleExportGroup" Header="Export articole" Margin="0,14,0,0">
              <StackPanel Margin="12">
                <Label x:Name="ArticleExportFolderLabel" Content="Folder pentru exportul articolelor" Target="{Binding ElementName=ArticleExportFolder}" />
                <TextBox x:Name="ArticleExportFolder" AutomationProperties.Name="Folder pentru exportul articolelor" />
                <TextBlock x:Name="ArticleExportFolderNotice" Text="Folderul implicit este Documente\Orizont RSS\Articole. Poți alege un alt folder." Style="{StaticResource SecondaryTextStyle}" Margin="4,6,4,0" TextWrapping="Wrap" />
                <Label x:Name="ArticleExportFormatLabel" Content="Format implicit pentru export" Target="{Binding ElementName=ArticleExportFormat}" Margin="0,8,0,0" />
                <ComboBox x:Name="ArticleExportFormat" AutomationProperties.Name="Format implicit pentru export">
                  <ComboBoxItem Content="Fișier TXT (.txt)" Tag="txt" />
                  <ComboBoxItem Content="Fișier RTF (.rtf)" Tag="rtf" />
                </ComboBox>
              </StackPanel>
            </GroupBox>
          </StackPanel>

          <!-- 2. Feeduri și actualizare -->
          <StackPanel x:Name="FeedsCategoryPanel" Visibility="Collapsed">
            <GroupBox x:Name="UpdateGroup" Header="Actualizare și afișare">
              <StackPanel Margin="12">
                <CheckBox x:Name="UpdateAtStartup" Content="Actualizează feedurile la pornire" AutomationProperties.Name="Actualizează feedurile la pornire" />
                <CheckBox x:Name="SoundAlerts" Content="Activează alertele sonore" AutomationProperties.Name="Activează alertele sonore" AutomationProperties.HelpText="Controlează toate alertele sonore ale actualizării feedurilor." />
                <CheckBox x:Name="SoundAlertOnSuccess" Content="Alertă la finalizarea reușită" AutomationProperties.Name="Alertă la finalizarea reușită" />
                <CheckBox x:Name="SoundAlertOnNewArticles" Content="Alertă când există articole noi" AutomationProperties.Name="Alertă când există articole noi" />
                <CheckBox x:Name="SoundAlertOnErrors" Content="Alertă la erori de feed" AutomationProperties.Name="Alertă la erori de feed" />
                <WrapPanel Margin="0,4,0,4">
                  <Button x:Name="TestSoundButton" Content="Testează sunetul" Click="TestSound_Click" />
                </WrapPanel>
                <TextBlock x:Name="SoundAlertStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" />
                <Separator Margin="4,10" />
                <CheckBox x:Name="HideRepeatedArticles" Content="Ascunde articolele repetate în vederile globale" AutomationProperties.Name="Ascunde articolele repetate în vederile globale" AutomationProperties.HelpText="Nu șterge articolele din feeduri. Afișează o singură copie când sunt combinate mai multe surse." />
              </StackPanel>
            </GroupBox>
          </StackPanel>

          <!-- 3. Cititor Orizont -->
          <StackPanel x:Name="ReaderCategoryPanel" Visibility="Collapsed">
            <GroupBox x:Name="ReaderGroup" Header="Cititor Orizont">
              <StackPanel Margin="12">
                <Label x:Name="ReaderModeLabel" Content="Mod implicit de afișare a articolelor" Target="{Binding ElementName=ReaderMode}" />
                <ComboBox x:Name="ReaderMode" AutomationProperties.Name="Mod implicit de afișare a articolelor">
                  <ComboBoxItem x:Name="ReaderModeTextItem" Content="Text simplu accesibil (cursor text clasic)" Tag="Text" />
                  <ComboBoxItem x:Name="ReaderModeWebViewItem" Content="WebReader (formatat web, navigare Virtual Cursor JAWS/NVDA)" Tag="WebView" />
                </ComboBox>
                <TextBlock x:Name="ReaderModeNotice" Text="Modul text simplu este recomandat pentru navigare tradițională cu săgețile. Modul WebReader permite navigarea prin taste rapide de browser (H pentru titluri, P pentru paragrafe, Tab pentru linkuri). Modul se poate comuta oricând și din fereastra Cititor cu combinația Ctrl+Shift+F8." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" TextWrapping="Wrap" />
                <Label x:Name="ArticleOpenModeLabel" Content="Deschiderea implicită a articolelor" Target="{Binding ElementName=ArticleOpenMode}" Margin="0,12,0,0" />
                <ComboBox x:Name="ArticleOpenMode" AutomationProperties.Name="Deschiderea implicită a articolelor">
                  <ComboBoxItem Content="Mod standard în fereastra principală" Tag="Standard" />
                  <ComboBoxItem Content="Cititor Orizont" Tag="Orizont" />
                </ComboBox>
                <TextBlock x:Name="ArticleOpenModeNotice" Text="Se aplică feedurilor care folosesc opțiunea Folosește setarea generală." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
            <GroupBox x:Name="ReaderPreferencesGroup" Header="Preferințe articole" Margin="0,14,0,0">
              <StackPanel Margin="12">
                <Label x:Name="ReadNowFavoriteDaysLabel" Content="Afișează articolele noi în Citește acum pentru" Target="{Binding ElementName=ReadNowFavoriteDays}" />
                <ComboBox x:Name="ReadNowFavoriteDays" AutomationProperties.Name="Perioada articolelor noi în Citește acum">
                  <ComboBoxItem Content="1 zi" Tag="1" />
                  <ComboBoxItem Content="3 zile" Tag="3" />
                  <ComboBoxItem Content="7 zile" Tag="7" />
                  <ComboBoxItem Content="14 zile" Tag="14" />
                  <ComboBoxItem Content="30 zile" Tag="30" />
                  <ComboBoxItem Content="60 zile" Tag="60" />
                  <ComboBoxItem Content="90 zile" Tag="90" />
                </ComboBox>
                <TextBlock x:Name="ReadNowFavoriteDaysNotice" Text="Favoritele și articolele De citit mai târziu rămân în Citește acum indiferent de vechime, până când le elimini manual." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
          </StackPanel>

          <!-- 4. Date și stocare -->
          <StackPanel x:Name="StorageCategoryPanel" Visibility="Collapsed">
            <GroupBox x:Name="StorageGroup" Header="Date și stocare">
              <StackPanel Margin="12">
                <CheckBox x:Name="AutoCleanup" Content="Șterge automat articolele obișnuite expirate" AutomationProperties.Name="Șterge automat articolele obișnuite expirate" />
                <Label x:Name="RetentionDaysLabel" Content="Păstrează articolele obișnuite timp de" Target="{Binding ElementName=RetentionDays}" />
                <ComboBox x:Name="RetentionDays" AutomationProperties.Name="Perioada de păstrare a articolelor obișnuite">
                  <ComboBoxItem Content="1 zi" Tag="1" />
                  <ComboBoxItem Content="3 zile" Tag="3" />
                  <ComboBoxItem Content="7 zile" Tag="7" />
                  <ComboBoxItem Content="14 zile" Tag="14" />
                  <ComboBoxItem Content="30 zile" Tag="30" />
                  <ComboBoxItem Content="60 zile" Tag="60" />
                  <ComboBoxItem Content="90 zile" Tag="90" />
                  <ComboBoxItem Content="180 zile" Tag="180" />
                  <ComboBoxItem Content="365 zile" Tag="365" />
                </ComboBox>
                <TextBlock x:Name="StorageNotice" Text="Favoritele și articolele De citit mai târziu sunt protejate și nu sunt șterse automat." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" />
                <Separator Margin="4,12" />
                <Button x:Name="CleanupButton" Content="Curăță acum articolele expirate" Click="CleanupNow_Click" HorizontalAlignment="Left" Margin="0,4,0,4" />
              </StackPanel>
            </GroupBox>
          </StackPanel>

          <!-- 5. Sincronizare NewsBlur -->
          <StackPanel x:Name="NewsBlurCategoryPanel" Visibility="Collapsed">
            <GroupBox x:Name="NewsBlurSyncGroup" Header="Sincronizare NewsBlur">
              <StackPanel Margin="12">
                <Label x:Name="NewsBlurSavedStoryModeLabel" Content="Articolele salvate în NewsBlur se sincronizează ca" Target="{Binding ElementName=NewsBlurSavedStoryMode}" />
                <ComboBox x:Name="NewsBlurSavedStoryMode" AutomationProperties.Name="Maparea articolelor salvate NewsBlur">
                  <ComboBoxItem Tag="Favorite" Content="Favorite" />
                  <ComboBoxItem Tag="ReadLater" Content="De citit mai târziu" />
                  <ComboBoxItem Tag="Both" Content="Favorite și De citit mai târziu" />
                </ComboBox>
                <TextBlock x:Name="NewsBlurSavedStoryModeNotice" Text="Stelele NewsBlur sunt articole salvate. Alegerea se aplică la următoarea sincronizare și nu șterge articole locale." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" TextWrapping="Wrap" />
                <CheckBox x:Name="NewsBlurSyncFeedsAndFoldersAtStartup" Content="Sincronizează feedurile și folderele NewsBlur la pornire" AutomationProperties.Name="Sincronizează feedurile și folderele NewsBlur la pornire" />
                <CheckBox x:Name="NewsBlurSyncArticlesAndStatesAtStartup" Content="Sincronizează articolele și stările NewsBlur la pornire" AutomationProperties.Name="Sincronizează articolele și stările NewsBlur la pornire" />
                <Separator Margin="4,10" />
                <CheckBox x:Name="NewsBlurAutoSyncEnabled" Content="Activează sincronizarea automată NewsBlur" AutomationProperties.Name="Activează sincronizarea automată NewsBlur" />
                <Label x:Name="NewsBlurAutoSyncMinutesLabel" Content="Interval sincronizare automată" Target="{Binding ElementName=NewsBlurAutoSyncMinutes}" />
                <ComboBox x:Name="NewsBlurAutoSyncMinutes" AutomationProperties.Name="Interval sincronizare automată NewsBlur">
                  <ComboBoxItem Tag="15" Content="La fiecare 15 minute" />
                  <ComboBoxItem Tag="30" Content="La fiecare 30 de minute" />
                  <ComboBoxItem Tag="60" Content="La fiecare oră" />
                  <ComboBoxItem Tag="180" Content="La fiecare 3 ore" />
                </ComboBox>
                <TextBlock x:Name="NewsBlurAutoSyncNotice" Text="Sincronizarea periodică include feeduri, foldere, articole și stări. Primele două bife controlează separat ce se sincronizează la pornire; comenzile manuale rămân disponibile." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,0" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
          </StackPanel>

          <!-- 6. Citire vocală -->
          <StackPanel x:Name="VoiceCategoryPanel" Visibility="Collapsed">
            <GroupBox x:Name="SpeechSettingsGroup" Header="Citire vocală">
              <StackPanel Margin="12">
                <TextBlock x:Name="SpeechNotice" Text="Vocea pornește numai la comanda ta și nu înlocuiește cititorul de ecran pentru citirea interfeței." Style="{StaticResource SecondaryTextStyle}" Margin="4,0,4,8" TextWrapping="Wrap" />
                <Label x:Name="SpeechEngineLabel" Content="Motor vocal" Target="{Binding ElementName=SpeechEngine}" />
                <ComboBox x:Name="SpeechEngine" AutomationProperties.Name="Motor vocal" SelectionChanged="SpeechEngine_SelectionChanged">
                  <ComboBoxItem x:Name="Sapi5EngineItem" Content="SAPI5, vocile instalate în Windows" Tag="Sapi5" />
                  <ComboBoxItem x:Name="EspeakEngineItem" Content="eSpeak NG, inclus în Orizont RSS" Tag="EspeakNg" />
                  <ComboBoxItem x:Name="GeminiEngineItem" Content="Gemini TTS, voci online" Tag="GeminiTts" />
                </ComboBox>
                <Label x:Name="SpeechVoiceLabel" Content="Voce" Target="{Binding ElementName=SpeechVoice}" />
                <ComboBox x:Name="SpeechVoice" AutomationProperties.Name="Vocea motorului vocal" />
                <StackPanel x:Name="EspeakVariantPanel">
                  <Label x:Name="EspeakVariantLabel" Content="Variantă vocală eSpeak NG" Target="{Binding ElementName=EspeakVariant}" />
                  <ComboBox x:Name="EspeakVariant" AutomationProperties.Name="Variantă vocală eSpeak NG" />
                </StackPanel>
                <Label x:Name="SpeechRateLabel" Content="Viteză, de la minus 10 la 10" Target="{Binding ElementName=SpeechRate}" />
                <ComboBox x:Name="SpeechRate" AutomationProperties.Name="Viteza vocii" />
                <StackPanel x:Name="EspeakPitchPanel">
                  <Label x:Name="EspeakPitchLabel" Content="Înălțimea vocii eSpeak, de la 0 la 100" Target="{Binding ElementName=EspeakPitch}" />
                  <ComboBox x:Name="EspeakPitch" AutomationProperties.Name="Înălțimea vocii eSpeak" />
                </StackPanel>
                <StackPanel x:Name="EspeakInflectionPanel">
                  <Label x:Name="EspeakInflectionLabel" Content="Intonația vocii eSpeak, de la 0 la 100" Target="{Binding ElementName=EspeakInflection}" />
                  <ComboBox x:Name="EspeakInflection" AutomationProperties.Name="Intonația vocii eSpeak" />
                </StackPanel>
                <TextBlock x:Name="GeminiSpeechNotice" Text="Gemini TTS este online. Textul citit este trimis la Google și poate consuma cota sau creditele API." Style="{StaticResource SecondaryTextStyle}" Margin="4,8,4,2" Visibility="Collapsed" TextWrapping="Wrap" />
                <Label x:Name="SpeechVolumeLabel" Content="Volum" Target="{Binding ElementName=SpeechVolume}" />
                <ComboBox x:Name="SpeechVolume" AutomationProperties.Name="Volumul vocii">
                  <ComboBoxItem Content="25 la sută" Tag="25" />
                  <ComboBoxItem Content="50 la sută" Tag="50" />
                  <ComboBoxItem Content="75 la sută" Tag="75" />
                  <ComboBoxItem Content="100 la sută" Tag="100" />
                </ComboBox>
                <CheckBox x:Name="StopSpeechWhenLeavingArticle" Content="Oprește vocea când ies din conținutul articolului cu Escape" AutomationProperties.Name="Oprește vocea când ies din conținutul articolului" />
                <WrapPanel Margin="0,6,0,0">
                  <Button x:Name="TestSpeechButton" Content="Testează vocea" Click="TestSpeech_Click" />
                  <Button x:Name="StopSpeechTestButton" Content="Oprește testul" Click="StopSpeechTest_Click" />
                </WrapPanel>
                <TextBlock x:Name="SpeechStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </GroupBox>
          </StackPanel>

          <!-- 7. Inteligență artificială și traducere -->
          <StackPanel x:Name="AiCategoryPanel" Visibility="Collapsed">
            <GroupBox x:Name="AiSettingsGroup" Header="Inteligență artificială">
              <StackPanel Margin="12">
                <Label x:Name="AiProviderLabel" Content="Furnizor AI" Target="{Binding ElementName=AiProviderSelector}" />
                <ComboBox x:Name="AiProviderSelector" SelectionChanged="AiProviderSelector_SelectionChanged" AutomationProperties.Name="Furnizor AI">
                  <ComboBoxItem Content="Gemini" Tag="Gemini" />
                  <ComboBoxItem Content="OpenAI" Tag="OpenAI" />
                  <ComboBoxItem Content="Mistral" Tag="Mistral" />
                  <ComboBoxItem x:Name="DeepSeekProviderItem" Content="Mistral" Tag="DeepSeek" />
                </ComboBox>
                <CheckBox x:Name="AiDefaultProvider" Content="Folosește ca furnizor implicit" Checked="AiDefaultProvider_Changed" Unchecked="AiDefaultProvider_Changed" AutomationProperties.Name="Folosește ca furnizor implicit" Margin="0,6,0,8" />
                <StackPanel x:Name="GeminiProviderPanel">
                  <TextBlock x:Name="GeminiSectionTitle" Text="Gemini" FontWeight="SemiBold" Margin="4,2,4,6" />
                  <CheckBox x:Name="GeminiEnabled" Content="Activează Gemini" AutomationProperties.Name="Activează Gemini" />
                  <Label x:Name="GeminiKeyLabel" Content="Cheie API Gemini" Target="{Binding ElementName=GeminiKey}" />
                  <PasswordBox x:Name="GeminiKey" AutomationProperties.Name="Cheie API Gemini" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="TestGeminiButton" Content="Testează conexiunea Gemini" Click="TestGemini_Click" />
                    <Button x:Name="GetGeminiKeyButton" Content="Obține cheie API Gemini" Click="GeminiKey_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="GeminiStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock x:Name="GeminiTestNotice" Text="Testul verifică modelele disponibile și nu trimite niciun articol." Style="{StaticResource SecondaryTextStyle}" Margin="4,2,4,8" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="OpenAiProviderPanel" Visibility="Collapsed">
                  <TextBlock x:Name="OpenAiSectionTitle" Text="OpenAI" FontWeight="SemiBold" Margin="4,2,4,6" />
                  <CheckBox x:Name="OpenAiEnabled" Content="Activează OpenAI" AutomationProperties.Name="Activează OpenAI" />
                  <Label x:Name="OpenAiKeyLabel" Content="Cheie API OpenAI" Target="{Binding ElementName=OpenAiKey}" />
                  <PasswordBox x:Name="OpenAiKey" AutomationProperties.Name="Cheie API OpenAI" />
                  <Label x:Name="OpenAiModelLabel" Content="Model OpenAI" Target="{Binding ElementName=OpenAiModel}" />
                  <ComboBox x:Name="OpenAiModel" IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="Model OpenAI" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="TestOpenAiButton" Content="Testează conexiunea OpenAI" Click="TestOpenAi_Click" />
                    <Button x:Name="GetOpenAiKeyButton" Content="Obține cheia API OpenAI" Click="OpenAiKey_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="OpenAiStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock x:Name="OpenAiNotice" Text="OpenAI API este facturat separat de abonamentul ChatGPT. Testul verifică modelele fără să trimită articol; întrebările AI trimit textul articolului către OpenAI." Style="{StaticResource SecondaryTextStyle}" Margin="4,2,4,8" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="MistralProviderPanel" Visibility="Collapsed">
                  <TextBlock x:Name="MistralSectionTitle" Text="Mistral" FontWeight="SemiBold" Margin="4,2,4,6" />
                  <CheckBox x:Name="MistralEnabled" Content="Mistral" AutomationProperties.Name="Mistral" />
                  <Label x:Name="MistralKeyLabel" Content="Mistral" Target="{Binding ElementName=MistralKey}" />
                  <PasswordBox x:Name="MistralKey" AutomationProperties.Name="Mistral" />
                  <Label x:Name="MistralModelLabel" Content="Mistral" Target="{Binding ElementName=MistralModel}" />
                  <ComboBox x:Name="MistralModel" IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="Mistral" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="TestMistralButton" Content="Mistral" Click="TestMistral_Click" />
                    <Button x:Name="GetMistralKeyButton" Content="Mistral" Click="MistralKey_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="MistralStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock x:Name="MistralNotice" Text="Mistral este un serviciu online. Testul enumeră modelele de conversație fără să trimită articolul. Când întrebi Mistral despre un articol, textul articolului este trimis furnizorului și poate consuma cota sau genera costuri în cont." Style="{StaticResource SecondaryTextStyle}" Margin="4,2,4,8" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="DeepSeekProviderPanel" Visibility="Collapsed">
                  <TextBlock x:Name="DeepSeekSectionTitle" Text="Mistral" FontWeight="SemiBold" Margin="4,2,4,6" />
                  <CheckBox x:Name="DeepSeekEnabled" Content="Activează Mistral" AutomationProperties.Name="Activează Mistral" />
                  <Label x:Name="DeepSeekKeyLabel" Content="Cheie API Mistral" Target="{Binding ElementName=DeepSeekKey}" />
                  <PasswordBox x:Name="DeepSeekKey" AutomationProperties.Name="Cheie API Mistral" />
                  <Label x:Name="DeepSeekModelLabel" Content="Model Mistral" Target="{Binding ElementName=DeepSeekModel}" />
                  <ComboBox x:Name="DeepSeekModel" IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="Model Mistral" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="TestDeepSeekButton" Content="Testează conexiunea Mistral" Click="TestDeepSeek_Click" />
                    <Button x:Name="GetDeepSeekKeyButton" Content="Obține cheia API Mistral" Click="DeepSeekKey_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="DeepSeekStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock x:Name="DeepSeekNotice" Text="Mistral este un serviciu online. Testul enumeră modelele de conversație fără să trimită articolul. Când întrebi Mistral despre un articol, textul articolului este trimis furnizorului și poate consuma cota sau genera costuri în cont." Style="{StaticResource SecondaryTextStyle}" Margin="4,2,4,8" TextWrapping="Wrap" />
                </StackPanel>
                <Separator Margin="4,8" />
                <TextBlock x:Name="DeepLTitle" Text="DeepL" FontWeight="SemiBold" Margin="4,2,4,6" />
                <CheckBox x:Name="DeepLEnabled" Content="Activează traducerea cu DeepL" AutomationProperties.Name="Activează traducerea cu DeepL" />
                <Label x:Name="DeepLKeyLabel" Content="Cheie API DeepL" Target="{Binding ElementName=DeepLKey}" />
                <PasswordBox x:Name="DeepLKey" AutomationProperties.Name="Cheie API DeepL" />
                <WrapPanel Margin="0,6,0,0">
                  <Button x:Name="TestDeepLButton" Content="Testează conexiunea DeepL" Click="TestDeepL_Click" />
                  <Button x:Name="GetDeepLKeyButton" Content="Obține cheie API DeepL" Click="DeepLKey_Click" />
                </WrapPanel>
                <TextBlock x:Name="DeepLStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="DeepLNotice" Text="DeepL este un serviciu online. Articolul este trimis la DeepL și consumă limita contului API." Style="{StaticResource SecondaryTextStyle}" Margin="4,2,4,8" TextWrapping="Wrap" />
                <TextBlock x:Name="DeepLInstructions" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="4,0,4,8" AutomationProperties.Name="DeepL setup instructions" />
                <Separator Margin="4,8" />
                <TextBlock x:Name="GoogleTranslateTitle" Text="Google Translate (fără cheie API)" FontWeight="SemiBold" Margin="4,2,4,6" />
                <Label x:Name="GoogleTranslateSourceLabel" Content="Limba sursă pentru Google Translate" Target="{Binding ElementName=GoogleTranslateSourceLanguage}" />
                <ComboBox x:Name="GoogleTranslateSourceLanguage" IsTextSearchEnabled="True" AutomationProperties.Name="Limba sursă pentru Google Translate" />
                <Label x:Name="GoogleTranslateTargetLabel" Content="Limba țintă pentru Google Translate" Target="{Binding ElementName=GoogleTranslateTargetLanguage}" />
                <ComboBox x:Name="GoogleTranslateTargetLanguage" IsTextSearchEnabled="True" AutomationProperties.Name="Limba țintă pentru Google Translate" />
                <TextBlock x:Name="GoogleTranslateNotice" Text="Traducerea folosește un serviciu online Google. Textul complet se trimite numai după confirmarea din articol." TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="4,6,4,8" />
                <Separator Margin="4,8" />
                <Label x:Name="AiInstructionsLabel" Content="Instrucțiuni permanente pentru agent" Target="{Binding ElementName=AiInstructions}" />
                <TextBox x:Name="AiInstructions" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Instrucțiuni permanente pentru agentul AI" />
                <TextBlock x:Name="AiInstructionsNotice" Text="Instrucțiunile se aplică rezumării, traducerii și conversațiilor viitoare despre articole." Style="{StaticResource SecondaryTextStyle}" Margin="4,6,4,0" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}">
      <Button x:Name="CancelButton" Content="Anulează" IsCancel="True" />
      <Button x:Name="SaveButton" Content="Salvează" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
