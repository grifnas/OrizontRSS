<Window x:Class="CititorRSS.Jaws.YouTubePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Videoclip YouTube" Width="900" Height="640" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
  <DockPanel>
    <StatusBar x:Name="WindowStatusBar" DockPanel.Dock="Bottom" Margin="0,8,0,0"
               Focusable="False" IsTabStop="False"
               AutomationProperties.LiveSetting="Polite">
      <StatusBarItem Focusable="False" IsTabStop="False">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
      </StatusBarItem>
    </StatusBar>
    <wv2:WebView2 x:Name="PlayerWebView" Margin="8" />
  </DockPanel>
</Window>
