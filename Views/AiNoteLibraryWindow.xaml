<Window x:Class="CititorRSS.Jaws.AiNoteLibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bibliotecă de notițe AI" Width="1000" Height="560" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Bibliotecă de notițe AI" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Caută în toate notițele salvate, apoi selectează un rezultat pentru a-i citi conținutul." Style="{StaticResource DialogIntroTextStyle}" /></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="390" MinWidth="280" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" MinWidth="320" /></Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Header="Notițe salvate"><DockPanel><Label DockPanel.Dock="Top" Content="Caută în bibliotecă" Target="{Binding ElementName=Search}" /><TextBox x:Name="Search" DockPanel.Dock="Top" TextChanged="Search_TextChanged" AutomationProperties.Name="Caută în notițele AI" AutomationProperties.HelpText="Caută în titlul articolului, numele feedului și conținutul notiței." /><ListBox x:Name="NotesList" SelectionChanged="NotesList_SelectionChanged" AutomationProperties.Name="Notițe AI salvate"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Note.Title}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Article.Title}" TextWrapping="Wrap" Margin="0,3,0,0" /><TextBlock Text="{Binding DisplayDate}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Focusable="False" IsTabStop="False" />
      <GroupBox Grid.Column="2" Header="Conținutul notiței"><TextBox x:Name="NoteContent" Style="{StaticResource ReadOnlyDocumentStyle}" AutomationProperties.Name="Conținut notiță AI, numai citire" AutomationProperties.HelpText="Folosește săgețile pentru citire. Shift+Tab revine la lista notițelor." /></GroupBox>
    </Grid>
    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}"><Button Content="Închide" IsCancel="True" /></StackPanel>
  </Grid>
</Window>
