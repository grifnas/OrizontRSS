<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrizontSetup</AssemblyName>
    <RootNamespace>OrizontSetup</RootNamespace>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <InformationalVersion>1.6.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>Instalare Orizont RSS</Title>
    <Product>Orizont RSS</Product>
    <Authors>Grigore Frișan</Authors>
    <Company>Grigore Frișan</Company>
    <Description>Instalator accesibil pentru Orizont RSS</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\Assets\OrizontRSS.ico" Link="OrizontRSS.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(OfflinePackageZip)' != ''">
    <EmbeddedResource Include="$(OfflinePackageZip)" LogicalName="OrizontSetup.EmbeddedPackage.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(OfflinePackageHash)' != ''">
    <EmbeddedResource Include="$(OfflinePackageHash)" LogicalName="OrizontSetup.EmbeddedPackage.sha256" />
  </ItemGroup>
</Project>
