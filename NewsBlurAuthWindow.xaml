<Window x:Class="CititorRSS.Jaws.NewsBlurAuthWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Autentificare NewsBlur" Icon="Assets/OrizontRSS.ico" Width="660" Height="600" MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Autentificare NewsBlur" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Conectează Orizont RSS la contul tău NewsBlur. Parola nu este salvată; se păstrează numai sesiunea protejată pentru contul Windows curent." Style="{StaticResource DialogIntroTextStyle}" /></StackPanel>
    <TabControl Grid.Row="1" Margin="0,12,0,12">
      <TabItem Header="Autentificare">
        <StackPanel Margin="12">
          <Label Content="Nume utilizator NewsBlur" Target="{Binding ElementName=Username}" /><TextBox x:Name="Username" AutomationProperties.Name="Nume utilizator NewsBlur" AutomationProperties.HelpText="Introdu numele de utilizator NewsBlur, nu adresa de e-mail." />
          <Label Content="Parolă" Target="{Binding ElementName=Password}" /><PasswordBox x:Name="Password" AutomationProperties.Name="Parola NewsBlur" />
          <Button x:Name="LoginButton" Content="Autentifică-te" Click="Login_Click" Margin="0,12,0,0" />
          <Button x:Name="CheckSessionButton" Content="Verifică sesiunea NewsBlur" Click="CheckSession_Click" Margin="0,6,0,0" />
          <Button Content="Deschide NewsBlur în browser" Click="OpenNewsBlur_Click" Margin="0,6,0,0" />
          <StatusBar x:Name="LoginStatusBar" Focusable="False" IsTabStop="False" AutomationProperties.LiveSetting="Polite"><StatusBarItem><TextBlock x:Name="LoginStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" /></StatusBarItem></StatusBar>
        </StackPanel>
      </TabItem>
      <TabItem Header="Creează cont">
        <StackPanel Margin="12">
          <TextBlock Text="Contul se creează pe serverul NewsBlur. Orizont RSS nu primește și nu păstrează parola după operație." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <Label Content="Nume utilizator NewsBlur" Target="{Binding ElementName=SignupUsername}" /><TextBox x:Name="SignupUsername" AutomationProperties.Name="Nume utilizator NewsBlur pentru cont nou" />
          <Label Content="Adresă de e-mail" Target="{Binding ElementName=SignupEmail}" /><TextBox x:Name="SignupEmail" AutomationProperties.Name="Adresa de e-mail pentru cont nou" />
          <Label Content="Parolă" Target="{Binding ElementName=SignupPassword}" /><PasswordBox x:Name="SignupPassword" AutomationProperties.Name="Parola pentru cont nou" />
          <Label Content="Confirmă parola" Target="{Binding ElementName=SignupConfirmation}" /><PasswordBox x:Name="SignupConfirmation" AutomationProperties.Name="Confirmarea parolei pentru cont nou" />
          <Button x:Name="SignupButton" Content="Creează contul NewsBlur" Click="Signup_Click" Margin="0,12,0,0" />
          <StatusBar x:Name="SignupStatusBar" Focusable="False" IsTabStop="False" AutomationProperties.LiveSetting="Polite"><StatusBarItem><TextBlock x:Name="SignupStatus" Style="{StaticResource DialogStatusTextStyle}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" /></StatusBarItem></StatusBar>
        </StackPanel>
      </TabItem>
      <TabItem Header="OAuth">
        <StackPanel Margin="12">
          <TextBlock Text="Autentificarea prin Google, Facebook sau alt furnizor trebuie făcută prin OAuth NewsBlur. API-ul NewsBlur cere ca aplicația să primească în prealabil un client ID și un secret de la administratorul serviciului." Style="{StaticResource DialogIntroTextStyle}" TextWrapping="Wrap" />
          <TextBlock Text="Până la aprobarea clientului OAuth, butoanele furnizorilor nu sunt activate pentru a nu colecta sau expune date de autentificare." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
          <Button Content="Deschide documentația OAuth NewsBlur" Click="OpenOAuthDocs_Click" Margin="0,14,0,0" />
          <TextBlock Text="După primirea clientului OAuth vom adăuga fluxul de browser cu redirecționare locală și butoane pentru furnizorii confirmați de NewsBlur." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}"><Button x:Name="LogoutButton" Content="Deconectează NewsBlur" Click="Logout_Click" /><Button Content="Închide" IsCancel="True" /></StackPanel>
  </Grid>
</Window>
