<Window x:Class="CititorRSS.Jaws.HelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ajutor Orizont RSS" Icon="Assets/OrizontRSS.ico" Width="820" Height="620" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Ajutor Orizont RSS" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Scurtăturile sunt prezentate ca listă. Folosește săgețile, Home, End, Page Up și Page Down. Escape închide fereastra." Style="{StaticResource DialogIntroTextStyle}" /></StackPanel>
    <ListBox Grid.Row="1" x:Name="ShortcutList" AutomationProperties.Name="Scurtături de tastatură Orizont RSS" AutomationProperties.HelpText="Folosește săgețile Sus și Jos pentru parcurgerea scurtăturilor. Escape închide fereastra.">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" /></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Category}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,2" /><TextBlock Text="{Binding Shortcut}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Style="{StaticResource DialogButtonBarStyle}"><Button Content="Deschide ghidul complet HTML" Click="OpenGuide_Click" AutomationProperties.Name="Deschide ghidul complet al utilizatorului în browser" /><Button Content="Închide" IsCancel="True" /></StackPanel>
  </Grid>
</Window>
