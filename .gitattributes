# Repository text normalization. Do not run a bulk renormalization while a
# feature change is in progress; apply it in a clean, separately reviewed commit.
* text=auto

# Source, project, configuration and documentation files.
*.cs text
*.xaml text
*.csproj text
*.props text
*.targets text
*.json text
*.xml text
*.resx text
*.md text
*.html text
*.yml text
*.yaml text
*.ps1 text
*.py text
*.txt text
*.ini text
*.toml text

# Binary assets and generated packages.
*.dll binary
*.exe binary
*.pdb binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.wav binary
*.mp3 binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.ucd binary
