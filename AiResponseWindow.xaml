<Window x:Class="CititorRSS.Jaws.AiResponseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Răspuns Gemini" Width="860" Height="620" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Conversație despre articol" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Citește răspunsul cu săgețile. Continuarea conversației este prima acțiune, iar copierea, salvarea și trimiterea includ întreaga discuție." Style="{StaticResource DialogIntroTextStyle}" /></StackPanel>
    <GroupBox Grid.Row="1" Header="Conversație"><TextBox x:Name="Response" Style="{StaticResource ReadOnlyDocumentStyle}" AutomationProperties.Name="Conversație Gemini, numai citire" AutomationProperties.HelpText="Folosește săgețile Sus și Jos pentru citire. Tab trece la câmpul pentru continuarea conversației. Shift+F10 oferă citire, copiere și distribuire."><TextBox.ContextMenu><ContextMenu x:Name="ResponseContextMenu" AutomationProperties.Name="Acțiuni conversație AI"><MenuItem x:Name="ResponseSpeechMenuItem" Header="Citire vocală"><MenuItem x:Name="SpeakConversationMenuItem" Header="Citește selecția sau conversația" InputGestureText="F9 / Ctrl+Alt+V" Click="SpeakConversation_Click" /><MenuItem x:Name="SpeakFromCursorMenuItem" Header="Citește cu voce de la cursor" Click="SpeakFromCursor_Click" /><MenuItem x:Name="PauseSpeechMenuItem" Header="Pauză sau continuă" InputGestureText="F9 / Ctrl+Alt+P" Click="PauseResumeSpeech_Click" /><MenuItem x:Name="StopSpeechMenuItem" Header="Oprește citirea" InputGestureText="Escape / Ctrl+Alt+S" Click="StopSpeech_Click" /></MenuItem><MenuItem x:Name="ResponseCopyShareMenuItem" Header="Copiere și distribuire"><MenuItem x:Name="CopyConversationMenuItem" Header="Copiază conversația" Click="CopyResponse_Click" /><MenuItem x:Name="CopyConversationDocumentMenuItem" Header="Copiază conversația AI cu articolul și sursa" Click="CopyResponseDocument_Click" /><MenuItem x:Name="EmailConversationMenuItem" Header="Distribuie conversația AI prin e-mail" Click="EmailResponse_Click" /><MenuItem x:Name="WhatsAppConversationMenuItem" Header="Distribuie conversația AI prin WhatsApp" Click="WhatsAppResponse_Click" /></MenuItem><MenuItem x:Name="FocusFollowUpMenuItem" Header="Continuă conversația" Click="FocusFollowUp_Click" /></ContextMenu></TextBox.ContextMenu></TextBox></GroupBox>
    <GroupBox Grid.Row="2" Header="Continuă conversația" Margin="4,14,4,4"><StackPanel Margin="8"><Label Content="Întrebarea următoare" Target="{Binding ElementName=FollowUpQuestion}" /><TextBox x:Name="FollowUpQuestion" AcceptsReturn="True" TextWrapping="Wrap" Height="86" VerticalScrollBarVisibility="Auto" KeyDown="FollowUpQuestion_KeyDown" AutomationProperties.Name="Continuă conversația cu Gemini" AutomationProperties.HelpText="Scrie întrebarea următoare. Ctrl+Enter trimite întrebarea." /><StackPanel Style="{StaticResource DialogButtonBarStyle}" Margin="0,8,0,0"><Button x:Name="SendFollowUpButton" Content="Trimite întrebarea" Click="SendFollowUp_Click" /></StackPanel></StackPanel></GroupBox>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="SpeakConversationButton" Content="Citește selecția sau conversația" Click="SpeakConversation_Click" AutomationProperties.Name="Citește selecția sau conversația" />
      <Button x:Name="PauseSpeechButton" Content="Pauză sau continuă" Click="PauseResumeSpeech_Click" />
      <Button x:Name="StopSpeechButton" Content="Oprește citirea" Click="StopSpeech_Click" />
      <Button Content="Copiază conversația" Click="CopyResponse_Click" AutomationProperties.Name="Copiază întreaga conversație AI" />
      <Button x:Name="CopyResponseDocumentButton" Content="Copiază cu articolul și sursa" Click="CopyResponseDocument_Click" AutomationProperties.Name="Copiază conversația AI cu articolul și sursa" />
      <Button Content="Salvează conversația" Click="SaveNote_Click" AutomationProperties.Name="Salvează întreaga conversație AI ca notiță a articolului" />
      <Button Content="Exportă conversația" Click="ExportResponse_Click" AutomationProperties.Name="Exportă întreaga conversație AI în fișier" />
      <Button x:Name="EmailResponseButton" Content="Distribuie conversația" Click="EmailResponse_Click" AutomationProperties.Name="Distribuie întreaga conversație AI prin e-mail" />
      <Button x:Name="WhatsAppResponseButton" Content="Distribuie prin WhatsApp" Click="WhatsAppResponse_Click" AutomationProperties.Name="Distribuie conversația AI prin WhatsApp" />
      <Button Content="Închide" IsCancel="True" />
    </WrapPanel>
    <StatusBar x:Name="ResponseStatusBar" Grid.Row="4" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"><StatusBarItem Focusable="False" IsTabStop="False"><TextBlock x:Name="SpeechStatus" Text="Citire vocală" AutomationProperties.LiveSetting="Polite" /></StatusBarItem></StatusBar>
  </Grid>
</Window>
